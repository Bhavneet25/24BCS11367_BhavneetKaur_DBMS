INSERT INTO Orders VALUES (4, 'Amrit', 25000);
INSERT INTO Orders VALUES (5, 'Pranjal', 12000);
INSERT INTO Orders VALUES (6, 'Puneet', 7000);

COMMIT;
DECLARE
    CURSOR order_cursor IS
        SELECT Order_ID, Customer_Name, Amount
        FROM Orders;

BEGIN
    FOR order_rec IN order_cursor
    LOOP
        IF order_rec.Amount > 10000 THEN
            DBMS_OUTPUT.PUT_LINE(
                'Order ID: ' || order_rec.Order_ID ||
                ' - High Value'
            );
        END IF;
    END LOOP;
END;
/
